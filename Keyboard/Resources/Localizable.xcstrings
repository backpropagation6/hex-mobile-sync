{
  "sourceLanguage": "en",
  "strings": {
    "A dictation is ready. Tap the insert key to add it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dettatura è pronta. Tocca il tasto Inserisci per aggiungerla."
          }
        }
      }
    },
    "Cancel dictation": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla dettatura"
          }
        }
      }
    },
