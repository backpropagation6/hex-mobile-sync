<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent template for hex-mobile-sync. Rendered by install.sh; the
  double-underscore placeholders are replaced with XML-escaped values. Do not load this file
  directly.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROGRAM__</string>
        <string>--once</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
        <key>HEX_CLI</key>
        <string>__HEX_CLI__</string>
        <key>HEX_MOBILE_SYNC_DIR</key>
        <string>__SYNC_DIR__</string>
        <key>HEX_SETTINGS_FILE</key>
        <string>__SETTINGS_FILE__</string>
        <key>HEX_MOBILE_LOG</key>
        <string>__LOG__</string>
    </dict>

    <!-- Run when Hex saves its settings or the iPhone writes pending vocabulary. -->
    <key>WatchPaths</key>
    <array>
        <string>__SETTINGS_FILE__</string>
        <string>__PENDING_FILE__</string>
    </array>

    <!-- And every 15 minutes, in case a file event was missed. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>

    <!-- The script logs to HEX_MOBILE_LOG; this only catches crashes of bash itself. -->
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>__LAUNCHD_LOG__</string>
</dict>
</plist>
